{
  "name": "pro-code",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "runtime": "node server/automatic-runtime.mjs",
    "runtime:bare": "node server/nexus.mjs",
    "start": "node server/automatic-runtime.mjs",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run test:runtime && npm run test:code-intelligence && npm run test:code-completion && npm run test:code-knowledge && npm run test:code-refactor && vitest run --exclude server/nexus.test.mjs --exclude server/automation.test.mjs --exclude server/automatic-runtime.test.mjs --exclude server/innovation.test.mjs --exclude scripts/code-intelligence.test.mjs --exclude scripts/code-completion.test.mjs --exclude scripts/code-knowledge.test.mjs --exclude scripts/code-refactor.test.mjs --exclude scripts/refactor-transaction.test.mjs",
    "test:runtime": "node --test server/nexus.test.mjs server/automation.test.mjs server/automatic-runtime.test.mjs server/innovation.test.mjs",
    "workers": "ls -la $HOME/.kiro/workers",
    "code:inspect": "node scripts/code-intelligence.mjs",
    "test:code-intelligence": "node --test scripts/code-intelligence.test.mjs && node scripts/code-intelligence.mjs --impact src/workers.ts --out .pro-code/runtime/code-impact.json --fail-on-diagnostics",
    "code:complete": "node scripts/code-completion.mjs",
    "test:code-completion": "node --test scripts/code-completion.test.mjs",
    "code:knowledge": "node scripts/code-knowledge.mjs",
    "test:code-knowledge": "node --test scripts/code-knowledge.test.mjs && node scripts/code-knowledge.mjs --symbol workersManager --definition-file src/workers.ts --out .pro-code/runtime/code-knowledge.json --fail-on-diagnostics",
    "code:refactor": "node scripts/code-refactor.mjs",
    "test:code-refactor": "node --test scripts/code-refactor.test.mjs scripts/refactor-transaction.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "memory": {
    "enabled": true,
    "path": "$HOME/.kiro/mem_links",
    "cache": "$HOME/.kiro/cache",
    "sync": {
      "aspen_grove": "$HOME/00_STRATEGY_CORE",
      "gemini": "$HOME/.gemini"
    }
  },
  "workers": {
    "enabled": true,
    "path": "$HOME/.kiro/workers",
    "list": [
      "strategist",
      "coordinator",
      "analyst",
      "creator",
      "database-crawler",
      "memory-specialist",
      "python-executor",
      "api-manager",
      "mcp-manager",
      "photo-analyzer",
      "video-processor",
      "case-analyzer",
      "motion-generator"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0"
  },
  "resolutions": {
    "brace-expansion": "5.0.8",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0"
  }
}
