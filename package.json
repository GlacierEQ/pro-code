{
  "name": "pro-code",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "workers": "ls -la $HOME/.kiro/workers"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.21"
  },
  "memory": {
    "enabled": true,
    "path": "$HOME/.kiro/mem_links",
    "cache": "$HOME/.kiro/cache",
    "sync": {
      "aspen_grove": "$HOME/00_STRATEGY_CORE",
      "gemini": "$HOME/.gemini"
    }
  },
  "workers": {
    "enabled": true,
    "path": "$HOME/.kiro/workers",
    "list": [
      "strategist", "coordinator", "analyst", "creator",
      "database-crawler", "memory-specialist", "python-executor",
      "api-manager", "mcp-manager", "photo-analyzer",
      "video-processor", "case-analyzer", "motion-generator"
    ]
  }
}
