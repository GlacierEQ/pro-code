# Browser dispatch runtime. Development defaults to http://127.0.0.1:8787.
VITE_NEXUS_BASE_URL=

# Development defaults to CASE-LOCAL-DEMO. Set the real case/workspace identifier.
VITE_CASE_ID=

# Automatic workspace intelligence is enabled by default.
PRO_CODE_AUTOMATION_ENABLED=true

# Directory to inventory, hash, classify, and monitor. Defaults to this repository.
PRO_CODE_WORKSPACE_DIR=

# Generated manifest, report, and status directory.
# Defaults to <workspace>/.pro-code/runtime.
PRO_CODE_RUNTIME_DIR=

# Refresh interval in milliseconds. Default: 300000 (five minutes).
PRO_CODE_AUTOMATION_INTERVAL_MS=300000

# Safety limits.
PRO_CODE_MAX_FILES=25000
PRO_CODE_MAX_HASH_BYTES=268435456

# Optional atomic memory snapshot destinations.
PRO_CODE_ASPEN_DIR=
PRO_CODE_GEMINI_DIR=
