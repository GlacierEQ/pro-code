{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.local/helix/repo-profile.schema.json",
  "title": "Helix Repo Profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "repo",
    "canonical_name",
    "aliases",
    "helix_role",
    "tier",
    "status",
    "mission",
    "hidden_substrate",
    "pillar_domains",
    "piston_domains",
    "secret_policy",
    "evidence_policy",
    "phase",
    "last_updated"
  ],
  "properties": {
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "canonical_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "helix_role": {"type": "string", "enum": ["doctrine_strand", "runtime_strand"]},
    "tier": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 20},
    "paired_runtime_strand": {"type": "string"},
    "paired_doctrine_strand": {"type": "string"},
    "aspen_grove_root": {"type": "string"},
    "mastermind_doctrine": {"type": "string"},
    "mastermind_runtime": {"type": "string"},
    "primary_visible_files": {"type": "array", "items": {"type": "string"}},
    "hidden_substrate": {"type": "object", "minProperties": 2},
    "pillar_domains": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "piston_domains": {"type": "array", "items": {"type": "string"}},
    "secret_policy": {"type": "string", "pattern": "no_raw_secrets"},
    "evidence_policy": {"type": "string"},
    "phase": {"type": "string", "pattern": "^phase_1[ab]_"},
    "last_updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
